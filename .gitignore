# Firebase project config: ties the build to a specific Firebase project and
# carries its API keys. See docs/CLOUD_SYNC.md.
google-services.json

# Private working documents & agent state — never commit
AGENTS.md
CLAUDE.md
.claude/
docs/TESTER_EMAIL.md

# Water-verification corpus: bottle photographs. The privacy policy promises
# these are not retained, so they must never enter the repository.
# See tools/water/README.md.
tools/water/corpus/
tools/**/__pycache__/
.pytest_cache/
tools/water/.pytest_cache/

# Play Console working notes (release checklist, store texts) — kept locally
docs/PLAY_PUBLISHING.md
docs/STORE_LISTING.md

# The locked alarms' tone is the user's own copy of a commercial song: personal
# use only, never published. The app falls back to the phone's alarm sound without it.
app/src/main/res/raw/locked_alarm.*
wear/src/main/res/raw/locked_alarm.*
