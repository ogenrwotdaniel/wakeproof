rules_version = '2';

// WakeProof cloud sync.
//
// The whole data model is "a user's own devices share the user's own data", so
// the only rule that matters is that a signed-in user can reach exactly the tree
// under their own uid and nothing else. There is no sharing, no admin surface and
// no cross-user read anywhere in the app.
//
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the collections the phone, tablet, watch and laptop write, so a bug or
    // a stolen token cannot grow the tree into new places. Keep in step with
    // SyncTable.kt, SyncEngine, LiveFocusSession, LiveCloudFeed, StudyUsageSync,
    // ClipCloud, wear/CloudDocuments.kt and tools/clip/clipsync/cloud.py.
    function owner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function knownCollection(collection) {
      return collection in [
        'alarms', 'completion_logs', 'flashcards', 'exams', 'parked_thoughts',
        'settings', 'live', 'studyUsage', 'clips'
      ];
    }

    // Every document WakeProof writes is a flat record of a few dozen fields at
    // most; a clip chunk is one field. Firestore caps a document at 1 MiB anyway.
    function reasonableShape() {
      return request.resource.data.keys().size() <= 64;
    }

    match /users/{userId}/{collection}/{docId} {
      allow read, delete: if owner(userId) && knownCollection(collection);
      allow create, update: if owner(userId) && knownCollection(collection) && reasonableShape();
    }

    // Anything not matched above is denied. Firestore denies by default, but
    // saying so explicitly keeps a future "just for testing" wildcard from being
    // added above without someone noticing what it costs.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
